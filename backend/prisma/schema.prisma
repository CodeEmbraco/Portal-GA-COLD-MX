// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  // url      = env("DATABASE_URL") // SE NECESITA AGREGAR EL DB URL
}

model Usuario {
  //Atributos (Columnas de la tabla)
  id                     Int            @id @default(autoincrement())
  correo                 String         @unique
  contraseña             String
  usuarioActiveDirectory String

  //Se declara que un usuario puede tener muchos de estos (se creara la tabla de relacion al ser muchos a muchos)
  rol                    Rol[]
  departamento           Departamento[]

  //Alias (punteros) para que prisma no batalle con las relaciones, usuario se usara como llave foranea en estos
  politicasSubidas       Politica[]       @relation("PoliticaSubidaPor")
  politicasModificadas   Politica[]       @relation("PoliticaModificadaPor")
  archivosSubidos        Archivo[]        @relation("ArchivoSubidoPor")
  archivosModificados    Archivo[]        @relation("ArchivoModificadoPor")
  versionesSubidas       VersionArchivo[] @relation("VersionSubidaPor")
  versionesModificadas   VersionArchivo[] @relation("VersionModificadaPor")
}

model Rol {
  id          Int       @id @default(autoincrement())
  rol         String
  descripcion String
  //Un rol puede tener muchos usuarios, se genera tabla de relacion
  usuario     Usuario[]
}

model Departamento {
  id        Int        @id @default(autoincrement())
  nombre    String
  entidadId Int
  //Un departamento puede tener varios departamentos, se genera tabla de relacion
  usuario   Usuario[]
  //Un departamento puede tener varias politicas, se usara departamento como llave foranea en politica
  politica  Politica[]
  //Un departamento solo puede tener una entidad, por lo que usamos la entidad como llave foranea
  entidad   Entidad    @relation(fields: [entidadId], references: [id])
}

model Entidad {
  id           Int            @id @default(autoincrement())
  planta       String
  pais         String
  estado       String
  direccion    String
  //Una entidad puede tener muchos departamentos, se usa entidad como llave foranea en departamento
  departamento Departamento[]
}

model Politica {
  id              Int       @id @default(autoincrement())
  titulo          String
  departamentoId  Int
  subidoPor       Int
  fechaSubida     DateTime  @default(now())
  modificadoPor   Int
  fechaModificado DateTime  @updatedAt
  esPrivado       Boolean   @default(true)
  // <-- Una politica puede tener muchos archivos, se usara la politica como llave foranea en archivo
  archivos        Archivo[] 
  //Usamos las llaves foraneas que necesitamos ya que estas relaciones son de muchos a una sola politica
  departamento              Departamento @relation(fields: [departamentoId], references: [id])
  politicaUsuarioSubio      Usuario      @relation("PoliticaSubidaPor", fields: [subidoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  politicaUsuarioModificado Usuario      @relation("PoliticaModificadaPor", fields: [modificadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Archivo {
  id              Int              @id @default(autoincrement())
  codigo          String
  politicaId      Int
  subidoPor       Int
  fechaSubida     DateTime         @default(now())
  modificadoPor   Int
  fechaModificado DateTime         @updatedAt
  // Un archivo puede tener muchas versiones, se usara el archivo como llave foranea en versionArchivo
  versiones       VersionArchivo[] 
  //Usamos las llaves foraneas que necesitamos ya que estas relaciones son de muchos a un solo archivo
  politica                 Politica @relation(fields: [politicaId], references: [id])
  archivoUsuarioSubio      Usuario  @relation("ArchivoSubidoPor", fields: [subidoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  archivoUsuarioModificado Usuario  @relation("ArchivoModificadoPor", fields: [modificadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model VersionArchivo {
  id              Int      @id @default(autoincrement())
  archivoId       Int
  ruta            String
  version         Int
  active          Boolean  @default(true)
  subidoPor       Int
  fechaSubida     DateTime @default(now())
  modificadoPor   Int
  fechaModificado DateTime @updatedAt
  //Usamos las llaves foraneas que necesitamos ya que estas relaciones son de muchos a un solo archivo
  archivo                         Archivo @relation(fields: [archivoId], references: [id])
  versionArchivoUsuarioSubio      Usuario @relation("VersionSubidaPor", fields: [subidoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versionArchivoUsuarioModificado Usuario @relation("VersionModificadaPor", fields: [modificadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
